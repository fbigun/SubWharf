{
  // SubWharf：KV 快照存储 + 每日两次抓取（UTC 1:00/13:00 = 北京 09:00/21:00）
  // secrets：npx wrangler secret put SESSION_KEY|WRAP_KEY|SETUP_CODE
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subwharf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 1,13 * * *"]
  },
  "kv_namespaces": [
    // id 由 scripts/ensure-kv.mjs 在部署前自动检测/创建并回写（本地手动部署亦可用）
    { "binding": "KV", "id": "d3f4c9e06ef04b5692619f870142e394" }
  ]
}
